{%- liquid
  comment
    Filtering and sorting go through Shopify's storefront filters rather than
    client-side JS, so a filtered view survives a reload and can be shared as a
    URL. They only exist once Search & Discovery is installed and the
    availability and Size filters are switched on; without it this degrades to
    the count and the sort control.
  endcomment

  for filter in collection.filters
    if filter.param_name == 'filter.v.availability'
      assign availability_filter = filter
    elsif filter.param_name contains 'option' and filter.label == section.settings.size_label
      assign size_filter = filter
    endif
  endfor

  assign has_active_filters = false
  for filter in collection.filters
    if filter.active_values.size > 0
      assign has_active_filters = true
      break
    endif
  endfor

  assign current_sort = collection.sort_by | default: collection.default_sort_by

  comment
    CLEAR drops the filters but keeps whatever sort is in play.
  endcomment
  assign clear_url = collection.url
  if current_sort != blank and current_sort != collection.default_sort_by
    assign clear_url = collection.url | append: '?sort_by=' | append: current_sort
  endif
-%}

<div class="brand-shop__head">
  <h1>{{ collection.title | default: section.settings.heading }}</h1>
  {%- if section.settings.meta != blank -%}
    <p>{{ section.settings.meta }}</p>
  {%- endif -%}
</div>

{%- comment -%}
  Deliberately in normal flow, not sticky — it scrolls away with the page.
{%- endcomment -%}
<brand-collection class="brand-shop__bar">
  <div class="brand-shop__bar-inner">
    <div class="brand-shop__filters">
      {%- if availability_filter -%}
        <div class="brand-shop__chips">
          {%- liquid
            assign availability_url = collection.url
            if availability_filter.true_value.active
              assign availability_url = availability_filter.true_value.url_to_remove
            elsif availability_filter.false_value.active
              assign availability_url = availability_filter.false_value.url_to_remove
            endif
            assign availability_off = true
            if availability_filter.active_values.size > 0
              assign availability_off = false
            endif
          -%}

          <a
            href="{{ availability_url }}"
            class="brand-chip brand-chip--pill"
            aria-current="{{ availability_off }}"
          >
            {{- section.settings.all_label -}}
          </a>

          <a
            href="{% if availability_filter.true_value.active %}{{ availability_filter.true_value.url_to_remove }}{% else %}{{ availability_filter.true_value.url_to_add }}{% endif %}"
            class="brand-chip brand-chip--pill"
            aria-current="{{ availability_filter.true_value.active }}"
          >
            {{- section.settings.available_label -}}
          </a>

          {%- if availability_filter.false_value.count > 0 -%}
            <a
              href="{% if availability_filter.false_value.active %}{{ availability_filter.false_value.url_to_remove }}{% else %}{{ availability_filter.false_value.url_to_add }}{% endif %}"
              class="brand-chip brand-chip--pill"
              aria-current="{{ availability_filter.false_value.active }}"
            >
              {{- section.settings.sold_out_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if availability_filter and size_filter -%}
        <span class="brand-shop__divider" aria-hidden="true"></span>
      {%- endif -%}

      {%- if size_filter -%}
        <div class="brand-shop__sizes">
          <span class="brand-shop__sizes-label">{{ size_filter.label }}</span>
          <div class="brand-shop__chips brand-shop__chips--size">
            {%- for value in size_filter.values -%}
              <a
                href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                class="brand-chip brand-chip--square"
                aria-current="{{ value.active }}"
              >
                {{- value.label -}}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if has_active_filters -%}
        <a href="{{ clear_url }}" class="brand-shop__clear">{{ section.settings.clear_label }}</a>
      {%- endif -%}
    </div>

    <div class="brand-shop__meta">
      <span class="brand-shop__count">
        {%- if collection.products_count == 1 -%}
          1 {{ section.settings.count_singular }}
        {%- else -%}
          {{ collection.products_count }} {{ section.settings.count_plural }}
        {%- endif -%}
      </span>

      {%- if collection.sort_options.size > 0 -%}
        <form method="get" action="{{ collection.url }}" class="brand-shop__sort">
          {%- comment -%}
            Active filters ride along as hidden fields, or sorting would drop
            them.
          {%- endcomment -%}
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
            {%- endfor -%}
          {%- endfor -%}

          <label class="visually-hidden" for="brand-sort">{{ section.settings.sort_label }}</label>
          <select id="brand-sort" name="sort_by" ref="sort">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                {{- option.name -}}
              </option>
            {%- endfor -%}
          </select>

          {%- comment -%}
            Only reachable without JavaScript, where the select cannot submit
            itself.
          {%- endcomment -%}
          <button type="submit" class="brand-shop__sort-go">{{ section.settings.sort_label }}</button>
        </form>
      {%- endif -%}
    </div>
  </div>
</brand-collection>

{%- paginate collection.products by section.settings.per_page -%}
  {%- if collection.products.size > 0 -%}
    <section class="brand-grid brand-grid--{{ section.settings.columns }}">
      {%- for product in collection.products -%}
        {% render 'brand-product-tile',
          product: product,
          index: forloop.index,
          quick_add: section.settings.quick_add,
          loading: 'lazy'
        %}
      {%- endfor -%}
    </section>

    {%- if paginate.pages > 1 -%}
      <nav class="brand-shop__pages" aria-label="{{ section.settings.sort_label }}">
        {{- paginate | default_pagination -}}
      </nav>
    {%- endif -%}
  {%- else -%}
    <div class="brand-shop__empty">
      <h2>{{ section.settings.empty_heading }}</h2>
      <p>{{ section.settings.empty_body }}</p>
      <a href="{{ clear_url }}" class="brand-shop__empty-action">{{ section.settings.empty_action }}</a>
    </div>
  {%- endif -%}
{%- endpaginate -%}

{% stylesheet %}
  .brand-shop__head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
    padding: 26px var(--brand-gutter) 18px;
    border-bottom: var(--brand-rule);
  }

  .brand-shop__head h1 {
    flex: none;
    margin: 0;
    white-space: nowrap;
    font: 800 clamp(1.625rem, 3vw, 2.5rem) / 1.15 var(--brand-font-display);
    letter-spacing: -0.032em;
  }

  .brand-shop__head p {
    margin: 0;
    font: var(--brand-type-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--brand-navy-rgb) / 0.42);
  }

  .brand-shop__bar {
    position: relative;
    z-index: var(--layer-flat);
    display: block;
    background: var(--brand-white);
    border-bottom: var(--brand-rule);
  }

  .brand-shop__bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding: 14px var(--brand-gutter);
  }

  .brand-shop__filters {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .brand-shop__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .brand-shop__chips--size {
    gap: 6px;
  }

  .brand-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(var(--brand-navy-rgb) / 0.22);
    background: var(--brand-white);
    color: var(--brand-navy);
    font: var(--brand-type-label);
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--brand-transition),
      color var(--brand-transition),
      border-color var(--brand-transition);
  }

  .brand-chip:hover {
    border-color: var(--brand-navy);
    color: var(--brand-navy);
  }

  .brand-chip[aria-current='true'] {
    background: var(--brand-navy);
    border-color: var(--brand-navy);
    color: var(--brand-white);
  }

  .brand-chip--pill {
    padding: 9px 17px;
    border-radius: var(--brand-radius-pill);
    font-size: 0.65625rem;
    letter-spacing: 0.11em;
  }

  .brand-chip--square {
    min-width: 40px;
    padding: 9px 11px;
    border-radius: var(--brand-radius);
    font-size: 0.6875rem;
    letter-spacing: 0;
  }

  .brand-shop__divider {
    width: 1px;
    height: 22px;
    background: rgb(var(--brand-navy-rgb) / 0.14);
  }

  .brand-shop__sizes {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .brand-shop__sizes-label {
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgb(var(--brand-navy-rgb) / 0.42);
  }

  .brand-shop__clear {
    padding: 0;
    border: 0;
    border-bottom: 1px solid rgb(var(--brand-navy-rgb) / 0.3);
    background: none;
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    line-height: 1.4;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(var(--brand-navy-rgb) / 0.55);
  }

  .brand-shop__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .brand-shop__count {
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgb(var(--brand-navy-rgb) / 0.42);
    white-space: nowrap;
  }

  .brand-shop__sort select {
    padding: 9px 30px 9px 13px;
    border: 1px solid rgb(var(--brand-navy-rgb) / 0.22);
    border-radius: var(--brand-radius);
    background: var(--brand-white);
    color: var(--brand-navy);
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    line-height: 1;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
    appearance: none;
    min-width: 0;
  }

  /* Present for anyone without JavaScript, out of the way for everyone else. */
  .brand-shop__sort-go {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .brand-shop__sort-go:focus {
    position: static;
    width: auto;
    height: auto;
    padding: 9px 13px;
    overflow: visible;
    clip-path: none;
    border: 1px solid var(--brand-navy);
    border-radius: var(--brand-radius);
    background: var(--brand-navy);
    color: var(--brand-white);
    font: var(--brand-type-label);
    text-transform: uppercase;
  }

  .brand-shop__empty {
    padding: clamp(4rem, 9vw, 8.125rem) var(--brand-gutter);
    text-align: center;
    border-bottom: var(--brand-rule);
  }

  .brand-shop__empty h2 {
    margin: 0 0 12px;
    font: 800 clamp(1.5rem, 3vw, 2.375rem) / 1.05 var(--brand-font-display);
    letter-spacing: -0.03em;
  }

  .brand-shop__empty p {
    margin: 0 0 26px;
    font: var(--brand-type-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(var(--brand-navy-rgb) / 0.55);
  }

  .brand-shop__empty-action {
    display: inline-block;
    padding: 14px 30px;
    border-radius: var(--brand-radius);
    background: var(--brand-navy);
    color: var(--brand-white);
    font: var(--brand-type-button);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--brand-transition);
  }

  .brand-shop__empty-action:hover {
    background: var(--brand-navy-hover);
    color: var(--brand-white);
  }

  .brand-shop__pages {
    padding: 32px var(--brand-gutter);
    border-bottom: var(--brand-rule);
    font: var(--brand-type-label);
    letter-spacing: var(--brand-tracking-label);
    text-align: center;
  }

  /* Phones: the bar becomes two rows and the chips wrap onto their own lines.
     A sideways-scrolling strip was tried and dropped — it hid half the sizes
     off the edge of the screen. */
  @media screen and (max-width: 759px) {
    .brand-shop__bar-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 11px;
      padding: 12px var(--brand-gutter);
    }

    .brand-shop__filters {
      width: 100%;
      gap: 10px;
    }

    .brand-shop__chips {
      gap: 6px;
    }

    .brand-shop__divider {
      display: none;
    }

    .brand-shop__sizes {
      width: 100%;
      gap: 10px;
    }

    /* The five sizes share the width rather than overflowing it. */
    .brand-shop__chips--size {
      flex: 1 1 0;
      min-width: 0;
    }

    .brand-chip--square {
      flex: 1 1 0;
      min-width: 0;
      padding: 13px 4px;
    }

    .brand-shop__meta {
      width: 100%;
      justify-content: space-between;
    }

    .brand-shop__sort select {
      flex: 0 1 auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop grid",
  "tag": "div",
  "class": "brand-collection-section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "All jerseys.",
      "info": "Used only if the collection has no title."
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Line beside the heading",
      "default": "SS26 · 2–7 BUSINESS DAYS IN SAUDI ARABIA · FREE OVER 200 SAR"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "info": "Always two across below 1040px.",
      "options": [
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Jerseys per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Reveal size chips on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Filter bar"
    },
    {
      "type": "paragraph",
      "content": "Filters come from Shopify's Search & Discovery app. Install it, then switch on the Availability and Size filters for this collection. Without it, only the count and sort appear."
    },
    {
      "type": "text",
      "id": "size_label",
      "label": "Name of the size filter",
      "default": "Size",
      "info": "Must match the product option name exactly."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Show everything",
      "default": "ALL"
    },
    {
      "type": "text",
      "id": "available_label",
      "label": "In stock only",
      "default": "AVAILABLE"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out only",
      "default": "SOLD OUT"
    },
    {
      "type": "text",
      "id": "clear_label",
      "label": "Clear filters",
      "default": "CLEAR"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort control",
      "default": "SORT"
    },
    {
      "type": "text",
      "id": "count_singular",
      "label": "Count, one result",
      "default": "JERSEY"
    },
    {
      "type": "text",
      "id": "count_plural",
      "label": "Count, several results",
      "default": "JERSEYS"
    },
    {
      "type": "header",
      "content": "When nothing matches"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading",
      "default": "Nothing in that combination."
    },
    {
      "type": "text",
      "id": "empty_body",
      "label": "Body",
      "default": "Try a different size, or clear the filters."
    },
    {
      "type": "text",
      "id": "empty_action",
      "label": "Button",
      "default": "CLEAR FILTERS"
    }
  ]
}
{% endschema %}
