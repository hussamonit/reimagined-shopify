{%- liquid
  comment
    Filtering and sorting go through Shopify's storefront filters rather than
    client-side JS, so a filtered view survives a reload and can be shared as a
    URL. They only exist once Search & Discovery is installed and the
    availability and Size filters are switched on; without it this degrades to
    the count and the sort control.
  endcomment

  comment
    Matched on shape rather than on name. Shopify's parameter names and labels
    vary with how the option is set up, so anything that behaves like a list of
    values gets a chip row and is labelled with whatever Shopify calls it.
  endcomment
  for filter in collection.filters
    if filter.type == 'boolean' or filter.param_name contains 'availability'
      assign availability_filter = filter
    endif
  endfor

  assign has_active_filters = false
  for filter in collection.filters
    if filter.active_values.size > 0
      assign has_active_filters = true
      break
    endif
  endfor

  assign current_sort = collection.sort_by | default: collection.default_sort_by

  comment
    CLEAR drops the filters but keeps whatever sort is in play.
  endcomment
  assign clear_url = collection.url
  if current_sort != blank and current_sort != collection.default_sort_by
    assign clear_url = collection.url | append: '?sort_by=' | append: current_sort
  endif
-%}

<div class="brand-shop__head">
  <h1>{{ collection.title | default: section.settings.heading }}</h1>
  {%- if section.settings.meta != blank -%}
    <p>{{ section.settings.meta }}</p>
  {%- endif -%}
</div>

{%- comment -%}
  Deliberately in normal flow, not sticky — it scrolls away with the page.
{%- endcomment -%}
<brand-collection class="brand-shop__bar">
  <div class="brand-shop__bar-inner">
    <div class="brand-shop__filters">
      {%- if availability_filter -%}
        {%- comment -%}
          Rendered from the filter's own values rather than from true_value and
          false_value, because Shopify hands availability over as a boolean on
          some setups and as a plain list on others. Going through values covers
          both, and ALL is just the link that drops the whole filter.
        {%- endcomment -%}
        {%- liquid
          assign availability_off = true
          if availability_filter.active_values.size > 0
            assign availability_off = false
          endif
          assign availability_reset = availability_filter.active_values.first.url_to_remove | default: collection.url
        -%}

        <div class="brand-shop__chips">
          <a href="{{ availability_reset }}" class="brand-chip brand-chip--pill" aria-current="{{ availability_off }}">
            {{- section.settings.all_label -}}
          </a>

          {%- for value in availability_filter.values -%}
            {%- if value.count == 0 and value.active == false -%}
              {%- continue -%}
            {%- endif -%}

            {%- liquid
              assign chip_label = value.label | upcase
              if value.value == '1'
                assign chip_label = section.settings.available_label
              elsif value.value == '0'
                assign chip_label = section.settings.sold_out_label
              endif
            -%}

            <a
              href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
              class="brand-chip brand-chip--pill"
              aria-current="{{ value.active }}"
            >
              {{- chip_label -}}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for filter in collection.filters -%}
        {%- comment -%}
          Size is the one that matters today, but anything list-shaped that gets
          switched on in Search & Discovery lands here with its own label.
          Availability is skipped — it has already had its own row above, and
          without this it comes round a second time as In stock / Out of stock.
        {%- endcomment -%}
        {%- if filter.type != 'list' or filter.values.size == 0 -%}
          {%- continue -%}
        {%- endif -%}

        {%- if availability_filter and filter.param_name == availability_filter.param_name -%}
          {%- continue -%}
        {%- endif -%}

        <span class="brand-shop__divider" aria-hidden="true"></span>

        <div class="brand-shop__sizes">
          <span class="brand-shop__sizes-label">{{ filter.label }}</span>
          <div class="brand-shop__chips brand-shop__chips--size">
            {%- for value in filter.values -%}
              <a
                href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                class="brand-chip brand-chip--square"
                aria-current="{{ value.active }}"
                aria-label="{{ value.label }}"
              >
                {%- render 'brand-size-label', label: value.label -%}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      {%- comment -%}
        Only in the editor: says plainly whether Shopify is returning any
        filters, so an empty bar can be told apart from a broken one.
      {%- endcomment -%}
      {%- if request.design_mode and collection.filters.size == 0 -%}
        <span class="brand-shop__note">
          No filters yet — install Search &amp; Discovery, then switch on Availability and Size for this collection.
        </span>
      {%- endif -%}

      {%- if has_active_filters -%}
        <a href="{{ clear_url }}" class="brand-shop__clear">{{ section.settings.clear_label }}</a>
      {%- endif -%}
    </div>

    <div class="brand-shop__meta">
      <span class="brand-shop__count">
        {%- if collection.products_count == 1 -%}
          1 {{ section.settings.count_singular }}
        {%- else -%}
          {{ collection.products_count }} {{ section.settings.count_plural }}
        {%- endif -%}
      </span>

      {%- if collection.sort_options.size > 0 -%}
        <form method="get" action="{{ collection.url }}" class="brand-shop__sort">
          {%- comment -%}
            Active filters ride along as hidden fields, or sorting would drop
            them.
          {%- endcomment -%}
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
            {%- endfor -%}
          {%- endfor -%}

          <label class="visually-hidden" for="brand-sort">{{ section.settings.sort_label }}</label>
          <select id="brand-sort" name="sort_by" ref="sort">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                {{- option.name -}}
              </option>
            {%- endfor -%}
          </select>

          {%- comment -%}
            Only reachable without JavaScript, where the select cannot submit
            itself.
          {%- endcomment -%}
          <button type="submit" class="brand-shop__sort-go">{{ section.settings.sort_label }}</button>
        </form>
      {%- endif -%}
    </div>

    {%- comment -%}
      A zero-height flex item that forces a wrap. On phones it splits the bar
      into exactly two rows — availability and sort above, sizes and the count
      below — rather than leaving the wrapping to whatever happens to fit.
    {%- endcomment -%}
    <span class="brand-shop__break" aria-hidden="true"></span>
  </div>
</brand-collection>

{%- paginate collection.products by section.settings.per_page -%}
  {%- if collection.products.size > 0 -%}
    <section class="brand-grid brand-grid--{{ section.settings.columns }}">
      {%- for product in collection.products -%}
        {% render 'brand-product-tile',
          product: product,
          index: forloop.index,
          quick_add: section.settings.quick_add,
          loading: 'lazy'
        %}
      {%- endfor -%}
    </section>

    {%- if paginate.pages > 1 -%}
      <nav class="brand-shop__pages" aria-label="{{ section.settings.pagination_label }}">
        {{- paginate | default_pagination -}}
      </nav>
    {%- endif -%}
  {%- else -%}
    <div class="brand-shop__empty">
      <h2>{{ section.settings.empty_heading }}</h2>
      <p>{{ section.settings.empty_body }}</p>
      <a href="{{ clear_url }}" class="brand-shop__empty-action">{{ section.settings.empty_action }}</a>
    </div>
  {%- endif -%}
{%- endpaginate -%}

{% stylesheet %}
  .brand-shop__head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
    padding: 26px var(--brand-gutter) 18px;
    border-bottom: var(--brand-rule);
  }

  .brand-shop__head h1 {
    flex: none;
    margin: 0;
    white-space: nowrap;
    font: 800 clamp(1.625rem, 3vw, 2.5rem) / 1.15 var(--brand-font-display);
    letter-spacing: -0.032em;
  }

  .brand-shop__head p {
    margin: 0;
    font: var(--brand-type-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--brand-navy-rgb) / 0.42);
  }

  .brand-shop__bar {
    position: relative;
    z-index: var(--layer-flat);
    display: block;
    background: var(--brand-white);
    border-bottom: var(--brand-rule);
  }

  .brand-shop__bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    padding: 10px var(--brand-gutter);
  }

  .brand-shop__filters {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .brand-shop__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .brand-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(var(--brand-navy-rgb) / 0.22);
    background: var(--brand-white);
    color: var(--brand-navy);
    font: var(--brand-type-label);
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--brand-transition),
      color var(--brand-transition),
      border-color var(--brand-transition);
  }

  .brand-chip:hover {
    border-color: var(--brand-navy);
    color: var(--brand-navy);
  }

  .brand-chip[aria-current='true'] {
    background: var(--brand-navy);
    border-color: var(--brand-navy);
    color: var(--brand-white);
  }

  .brand-chip--pill {
    padding: 7px 13px;
    border-radius: var(--brand-radius-pill);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .brand-chip--square {
    min-width: 34px;
    padding: 7px 9px;
    border-radius: var(--brand-radius);
    font-size: 0.625rem;
    letter-spacing: 0;
  }

  .brand-shop__divider {
    width: 1px;
    height: 18px;
    background: rgb(var(--brand-navy-rgb) / 0.14);
  }

  .brand-shop__sizes {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .brand-shop__sizes-label {
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgb(var(--brand-navy-rgb) / 0.42);
  }

  .brand-shop__clear {
    padding: 0;
    border: 0;
    border-bottom: 1px solid rgb(var(--brand-navy-rgb) / 0.3);
    background: none;
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    line-height: 1.4;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(var(--brand-navy-rgb) / 0.55);
  }

  .brand-shop__note {
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: rgb(var(--brand-navy-rgb) / 0.42);
  }

  .brand-shop__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .brand-shop__count {
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgb(var(--brand-navy-rgb) / 0.42);
    white-space: nowrap;
  }

  .brand-shop__sort select {
    padding: 9px 30px 9px 13px;
    border: 1px solid rgb(var(--brand-navy-rgb) / 0.22);
    border-radius: var(--brand-radius);
    background: var(--brand-white);
    color: var(--brand-navy);
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    line-height: 1;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
    appearance: none;
    min-width: 0;
  }

  /* Present for anyone without JavaScript, out of the way for everyone else. */
  .brand-shop__sort-go {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .brand-shop__sort-go:focus {
    position: static;
    width: auto;
    height: auto;
    padding: 9px 13px;
    overflow: visible;
    clip-path: none;
    border: 1px solid var(--brand-navy);
    border-radius: var(--brand-radius);
    background: var(--brand-navy);
    color: var(--brand-white);
    font: var(--brand-type-label);
    text-transform: uppercase;
  }

  .brand-shop__empty {
    padding: clamp(4rem, 9vw, 8.125rem) var(--brand-gutter);
    text-align: center;
    border-bottom: var(--brand-rule);
  }

  .brand-shop__empty h2 {
    margin: 0 0 12px;
    font: 800 clamp(1.5rem, 3vw, 2.375rem) / 1.05 var(--brand-font-display);
    letter-spacing: -0.03em;
  }

  .brand-shop__empty p {
    margin: 0 0 26px;
    font: var(--brand-type-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(var(--brand-navy-rgb) / 0.55);
  }

  .brand-shop__empty-action {
    display: inline-block;
    padding: 14px 30px;
    border-radius: var(--brand-radius);
    background: var(--brand-navy);
    color: var(--brand-white);
    font: var(--brand-type-button);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--brand-transition);
  }

  .brand-shop__empty-action:hover {
    background: var(--brand-navy-hover);
    color: var(--brand-white);
  }

  .brand-shop__pages {
    padding: 32px var(--brand-gutter);
    border-bottom: var(--brand-rule);
    font: var(--brand-type-label);
    letter-spacing: var(--brand-tracking-label);
    text-align: center;
  }

  /* Phones: the bar becomes two rows and the chips wrap onto their own lines.
     A sideways-scrolling strip was tried and dropped — it hid half the sizes
     off the edge of the screen. */
  .brand-shop__break {
    display: none;
  }

  /* Phones: two rows, not three. The grouping wrappers step out of the layout
     so every control becomes a flex item of the bar itself and can be ordered
     freely — availability and sort on the first row, sizes, count and clear on
     the second. */
  @media screen and (max-width: 759px) {
    .brand-shop__bar-inner {
      align-items: center;
      gap: 6px 8px;
      padding: 8px var(--brand-gutter);
    }

    .brand-shop__filters,
    .brand-shop__sizes,
    .brand-shop__meta {
      display: contents;
    }

    /* The chips are obviously sizes; the word only costs a row. */
    .brand-shop__sizes-label,
    .brand-shop__divider {
      display: none;
    }

    .brand-shop__chips {
      order: 1;
    }

    .brand-shop__sort {
      order: 2;
      margin-left: auto;
    }

    .brand-shop__break {
      display: block;
      flex: 1 0 100%;
      height: 0;
      order: 3;
    }

    .brand-shop__chips--size {
      order: 4;
      flex: 0 1 auto;
    }

    .brand-shop__count {
      order: 5;
    }

    .brand-shop__clear {
      order: 6;
    }

    .brand-chip--pill {
      padding: 6px 11px;
      font-size: 0.5625rem;
      letter-spacing: 0.08em;
    }

    .brand-chip--square {
      min-width: 30px;
      padding: 6px 7px;
      font-size: 0.5625rem;
    }

    .brand-shop__sort select {
      padding: 6px 24px 6px 10px;
      font-size: 0.5625rem;
    }

    .brand-shop__count {
      font-size: 0.5625rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop grid",
  "tag": "div",
  "class": "brand-collection-section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "All jerseys.",
      "info": "Used only if the collection has no title."
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Line beside the heading",
      "default": "SS26 · 2–7 BUSINESS DAYS IN SAUDI ARABIA · FREE OVER 200 SAR"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "info": "Always two across below 1040px.",
      "options": [
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Jerseys per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Reveal size chips on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Filter bar"
    },
    {
      "type": "paragraph",
      "content": "Filters come from Shopify's Search & Discovery app. Install it, then switch on the Availability and Size filters for this collection. Without it, only the count and sort appear."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Show everything",
      "default": "ALL"
    },
    {
      "type": "text",
      "id": "available_label",
      "label": "In stock only",
      "default": "AVAILABLE"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out only",
      "default": "SOLD OUT"
    },
    {
      "type": "text",
      "id": "clear_label",
      "label": "Clear filters",
      "default": "CLEAR"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort control",
      "default": "SORT"
    },
    {
      "type": "text",
      "id": "pagination_label",
      "label": "Pagination",
      "info": "Read out by screen readers, not shown on the page.",
      "default": "Pages"
    },
    {
      "type": "text",
      "id": "count_singular",
      "label": "Count, one result",
      "default": "JERSEY"
    },
    {
      "type": "text",
      "id": "count_plural",
      "label": "Count, several results",
      "default": "JERSEYS"
    },
    {
      "type": "header",
      "content": "When nothing matches"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading",
      "default": "Nothing in that combination."
    },
    {
      "type": "text",
      "id": "empty_body",
      "label": "Body",
      "default": "Try a different size, or clear the filters."
    },
    {
      "type": "text",
      "id": "empty_action",
      "label": "Button",
      "default": "CLEAR FILTERS"
    }
  ]
}
{% endschema %}
