{%- liquid
  assign accent = product.metafields.jersey.accent.value
  assign moment_title = product.metafields.jersey.moment_title.value
  assign moment_body = product.metafields.jersey.moment_body.value

  comment
    Per-product wide shot if one has been set, otherwise the one picked on the
    section — so this reads properly before every jersey has its own.
  endcomment
  assign moment_image = product.metafields.jersey.moment_image.value | default: section.settings.image
-%}

{%- if moment_title != blank or moment_body != blank -%}
  <section class="brand-moment">
    <div class="brand-moment__inner">
      <div data-reveal="0">
        <p class="brand-moment__eyebrow">
          {%- if accent -%}
            <span class="brand-moment__dot" style="background: {{ accent }}"></span>
          {%- endif -%}
          {{ section.settings.eyebrow }}
        </p>
        <h2 class="brand-moment__heading">{{ moment_title }}</h2>
      </div>

      <div class="brand-moment__body" data-reveal="130">
        {{ moment_body }}

        {%- if section.settings.meta != blank -%}
          <div class="brand-moment__meta">
            {%- assign meta_lines = section.settings.meta | newline_to_br | split: '<br />' -%}
            {%- for line in meta_lines -%}
              {%- assign trimmed = line | strip -%}
              {%- if trimmed != blank -%}
                <span>{{ trimmed }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if moment_image != blank -%}
      <div class="brand-moment__frame" data-reveal="0">
        {{
          moment_image
          | image_url: width: 2400
          | image_tag:
            width: 1200,
            widths: '600, 900, 1200, 1800, 2400',
            sizes: '(min-width: 1180px) 1180px, 100vw',
            loading: 'lazy',
            alt: moment_title
            | default: product.title
        }}
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .brand-moment {
    background: var(--brand-navy);
    color: var(--brand-white);
    padding: clamp(3.5rem, 7.5vw, 7.25rem) var(--brand-gutter);
  }

  .brand-moment__inner {
    max-width: var(--brand-max-width);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(1.875rem, 5vw, 4.5rem);
    align-items: start;
  }

  .brand-moment__eyebrow {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 22px;
    font: var(--brand-type-label);
    font-size: 0.71875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-on-navy-label);
  }

  .brand-moment__dot {
    flex: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .brand-moment__heading {
    margin: 0;
    font: 800 clamp(2rem, 4.4vw, 3.625rem) / 0.98 var(--brand-font-display);
    letter-spacing: -0.034em;
    text-wrap: pretty;
  }

  .brand-moment__body {
    padding-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .brand-moment__body p {
    margin: 0;
    font: 400 clamp(0.9375rem, 1.45vw, 1.125rem) / 1.62 var(--brand-font-display);
    color: rgb(255 255 255 / 0.76);
    text-wrap: pretty;
  }

  .brand-moment__meta {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-top: 8px;
    font: var(--brand-type-label);
    line-height: 1.5;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.42);
  }

  .brand-moment__frame {
    position: relative;
    max-width: var(--brand-max-width);
    margin: clamp(2.5rem, 5vw, 5rem) auto 0;
    aspect-ratio: 21 / 9;
    min-height: 210px;
    background: var(--brand-navy-raised);
    overflow: hidden;
  }

  .brand-moment__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Same trap as the story band: a height floor under a wide ratio resolves the
     width from the height and pushes the page sideways. */
  @media screen and (max-width: 759px) {
    .brand-moment__frame {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "The moment",
  "tag": "div",
  "class": "brand-moment-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE MOMENT"
    },
    {
      "type": "paragraph",
      "content": "The heading and paragraphs come from each jersey's moment_title and moment_body metafields."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image",
      "info": "Used for any jersey without its own moment image metafield."
    },
    {
      "type": "textarea",
      "id": "meta",
      "label": "Side notes",
      "info": "One per line.",
      "default": "DESIGNED IN BRAZIL · 23°33′ S · 46°38′ W\nNO LICENCES · NO REPLICAS"
    }
  ],
  "presets": [{ "name": "The moment" }]
}
{% endschema %}
