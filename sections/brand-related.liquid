{%- liquid
  comment
    Simply the other jerseys, which is what "the rest of the five" means. The
    recommendations object is left alone deliberately: it only fills in when the
    section is fetched through Shopify's recommendations endpoint, so it would
    render nothing here, and with five products a machine-picked four is the
    same four anyway.
  endcomment
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif

  assign limit = section.settings.limit
  assign shown = 0
-%}

{%- comment -%}
  Built first so the heading is only drawn if there is something under it — on a
  store with one jersey this section would otherwise be a title over an empty
  bordered box.
{%- endcomment -%}
{%- capture tiles -%}
  {%- for item in source.products -%}
    {%- if item.id == product.id -%}
      {%- continue -%}
    {%- endif -%}

    {%- if shown >= limit -%}
      {%- break -%}
    {%- endif -%}

    {% render 'brand-product-tile', product: item, index: forloop.index, compact: true, loading: 'lazy' %}

    {%- assign shown = shown | plus: 1 -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if tiles != blank -%}
  <section class="brand-related">
    <div class="brand-related__head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </section>

  <div class="brand-grid brand-grid--{{ section.settings.columns }} brand-grid--flush">{{ tiles }}</div>
{%- endif -%}

{% stylesheet %}
  .brand-related {
    padding: clamp(2.75rem, 5.5vw, 5rem) var(--brand-gutter) 0;
  }

  .brand-related__head {
    max-width: var(--brand-max-width);
    margin: 0 auto clamp(1.25rem, 2.5vw, 2.125rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }

  .brand-related__head h2 {
    margin: 0;
    font: 800 clamp(1.625rem, 3.2vw, 2.625rem) / 1.02 var(--brand-font-display);
    letter-spacing: -0.03em;
  }

  .brand-related__head a {
    font: var(--brand-type-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(var(--brand-navy-rgb) / 0.5);
    transition: color var(--brand-transition);
  }

  .brand-related__head a:hover {
    color: var(--brand-navy);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related jerseys",
  "tag": "div",
  "class": "brand-related-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to draw from",
      "info": "Defaults to all products. The jersey being viewed is always left out."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The rest of the five."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link",
      "default": "ALL JERSEYS →"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Jerseys shown",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "info": "Always two across below 1040px.",
      "options": [
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ],
      "default": "4"
    }
  ],
  "presets": [{ "name": "Related jerseys" }]
}
{% endschema %}
