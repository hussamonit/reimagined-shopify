    {
      "type": "checkbox",
      "id": "show_order_field",
      "label": "Ask for an order number",
      "default": true
    },
    {
      "type": "text",
      "id": "order_label",
      "label": "Order field",
      "default": "ORDER NUMBER"
    },
    {
      "type": "text",
      "id": "optional_label",
      "label": "Optional marker",
      "default": "— OPTIONAL"
    },
    {
      "type": "text",
      "id": "order_placeholder",
      "label": "Order placeholder",
      "default": "e.g. RMG-1042"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message field",
      "default": "MESSAGE"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Tell us what you need."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Button",
      "default": "SEND MESSAGE"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Add your name, a valid email and a message."
    },
    {
      "type": "header",
      "content": "After sending"
    },
    {
      "type": "text",
      "id": "sent_label",
      "label": "Label",
      "default": "MESSAGE SENT"
    },
    {
      "type": "text",
      "id": "sent_heading",
      "label": "Heading",
      "default": "Got it."
    },
    {
      "type": "textarea",
      "id": "sent_body",
      "label": "Body",
      "default": "We read every message ourselves and reply within 1–24 hours."
