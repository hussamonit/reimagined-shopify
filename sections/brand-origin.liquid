{%- comment -%}
  Where the designs come from. Brazil is allowed to show up here as a flag chip,
  an eyebrow and a set of coordinates — never as a story about the place.
{%- endcomment -%}

<section class="brand-origin">
  <div class="brand-origin__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="brand-origin__eyebrow" data-reveal="0">
        {%- if section.settings.show_flag -%}
          <span class="brand-origin__flag" aria-hidden="true"><span></span></span>
        {%- endif -%}
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}

    <h2 class="brand-origin__heading" data-reveal="0">{{ section.settings.heading }}</h2>

    <div class="brand-origin__body" data-reveal="120">
      {%- if section.settings.body_one != blank -%}
        <p class="brand-origin__text">{{ section.settings.body_one }}</p>
      {%- endif -%}

      {%- if section.settings.body_two != blank -%}
        <p class="brand-origin__text">{{ section.settings.body_two }}</p>
      {%- endif -%}

      <div class="brand-origin__meta">
        {%- assign meta_lines = section.settings.meta | newline_to_br | split: '<br />' -%}
        {%- for line in meta_lines -%}
          {%- assign trimmed = line | strip -%}
          {%- if trimmed != blank -%}
            <span>{{ trimmed }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .brand-origin {
    background: var(--brand-bone);
    border-bottom: var(--brand-rule);
    padding: clamp(3.75rem, 7.5vw, 7rem) var(--brand-gutter);
  }

  .brand-origin__inner {
    max-width: var(--brand-max-width);
    margin-inline: auto;
  }

  .brand-origin__eyebrow {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 0 0 clamp(1.375rem, 2.6vw, 2.125rem);
    font: var(--brand-type-label);
    font-size: 0.71875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--brand-navy-rgb) / 0.45);
  }

  /* Brazil, drawn rather than loaded — it is 27px wide and never needs to be
     anything else. */
  .brand-origin__flag {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex: none;
    width: 27px;
    height: 18px;
    border-radius: var(--brand-radius);
    background: #009b3a;
    box-shadow: inset 0 0 0 1px rgb(var(--brand-navy-rgb) / 0.14);
  }

  .brand-origin__flag span {
    width: 11px;
    height: 11px;
    background: #fedf00;
    transform: rotate(45deg);
  }

  /* Deliberately larger than the shared display size — this is the one heading
     on the site that runs to the full column. */
  .brand-origin__heading {
    margin: 0;
    max-width: 16ch;
    font: 800 clamp(2.5rem, 6.2vw, 5.625rem) / 0.94 var(--brand-font-display);
    letter-spacing: -0.04em;
    text-wrap: pretty;
    color: var(--brand-navy);
  }

  .brand-origin__body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: clamp(1.5rem, 3vw, 3.5rem);
    margin-top: clamp(2.125rem, 4vw, 3.625rem);
    border-top: 1px solid rgb(var(--brand-navy-rgb) / 0.16);
    padding-top: clamp(1.625rem, 3vw, 2.375rem);
  }

  .brand-origin__text {
    margin: 0;
    font: var(--brand-type-body);
    line-height: 1.62;
    color: rgb(var(--brand-navy-rgb) / 0.62);
    text-wrap: pretty;
  }

  .brand-origin__meta {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font: var(--brand-type-label);
    line-height: 1.5;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgb(var(--brand-navy-rgb) / 0.45);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Origin",
  "tag": "section",
  "class": "brand-origin-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_flag",
      "label": "Show flag chip",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DESIGNED IN BRAZIL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed among people who live it."
    },
    {
      "type": "textarea",
      "id": "body_one",
      "label": "First paragraph",
      "default": "A shirt only means anything because of what people do in it. Sung in, cried in, worn to work the morning after. Shirts get kept until they come apart, argued over, handed down — that is the part football merchandise keeps forgetting."
    },
    {
      "type": "textarea",
      "id": "body_two",
      "label": "Second paragraph",
      "default": "So every design gets judged by the people it is for, not by a brand team. If a supporter would not still be wearing it ten years after the match it is about, it does not get made."
    },
    {
      "type": "textarea",
      "id": "meta",
      "label": "Side notes",
      "info": "One per line.",
      "default": "23°33′ S · 46°38′ W\nNO LICENCES · NO REPLICAS\nFIVE MOMENTS · LIMITED RUNS"
    }
  ],
  "presets": [{ "name": "Origin" }]
}
{% endschema %}
