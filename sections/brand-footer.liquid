{% liquid
  comment
    The cart is designed to end on the wordmark band alone — link columns there
    would compete with the checkout button.
  endcomment

  assign show_columns = true
  if template.name == 'cart' and section.settings.full_footer_on_cart == false
    assign show_columns = false
  endif
%}

<div class="brand-footer">
  {%- if show_columns -%}
    {%- if section.blocks.size > 0 -%}
      <div class="brand-footer__columns" data-reveal="0">
        <div class="brand-footer__columns-inner">
          {%- for block in section.blocks -%}
            {%- comment -%}
              A column with no menu behind it yet is left out rather than shown
              as a heading over nothing.
            {%- endcomment -%}
            {%- if block.settings.menu.links.size > 0 -%}
              <div class="brand-footer__column" {{ block.shopify_attributes }}>
                <p class="brand-footer__column-heading">{{ block.settings.heading }}</p>
                {%- for link in block.settings.menu.links -%}
                  <a href="{{ link.url }}" class="brand-footer__link">{{ link.title }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="brand-footer__utility">
      {%- if section.settings.show_payment_marks -%}
        <div class="brand-footer__payments">
          {%- assign marks = 'visa,mastercard,mada,applepay,tabby,tamara' | split: ',' -%}
          {%- for mark in marks -%}
            {%- assign mark_asset = 'brand-pay-' | append: mark | append: '.png' -%}
            <span class="brand-footer__payment">
              <img src="{{ mark_asset | asset_url }}" alt="{{ mark }}" loading="lazy">
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="brand-footer__meta">
        <span class="brand-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        </span>

        <div class="brand-footer__meta-end">
          {%- if section.settings.locale_label != blank -%}
            <span class="brand-footer__locale">{{ section.settings.locale_label }}</span>
          {%- endif -%}

          <div class="brand-footer__social">
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" class="brand-footer__social-link" aria-label="Instagram">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="4.8"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.2" cy="6.8" r="1.15" fill="currentColor" stroke="none"/>
                </svg>
              </a>
            {%- endif -%}

            {%- if section.settings.tiktok_url != blank -%}
              <a href="{{ section.settings.tiktok_url }}" class="brand-footer__social-link" aria-label="TikTok">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-1.79-2.46V9.8a5.68 5.68 0 1 0 4.88 5.62V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.28 4.28 0 0 1-3.24-1.48z"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="brand-footer__band">
    <img src="{{ 'brand-wordmark-white.svg' | asset_url }}" alt="{{ shop.name }}" loading="lazy">
  </div>
</div>

{% stylesheet %}
  .brand-footer__columns {
    padding: clamp(2.75rem, 5vw, 4.25rem) var(--brand-gutter);
    border-bottom: var(--brand-rule);
  }

  .brand-footer__columns-inner {
    max-width: var(--brand-max-width);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 36px;
  }

  .brand-footer__column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .brand-footer__column-heading {
    margin: 0 0 4px;
    font: var(--brand-type-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-label-muted);
  }

  .brand-footer__link {
    font: var(--brand-type-body-sm);
    line-height: 1;
    text-decoration: none;
    color: var(--brand-navy);
    transition: color var(--brand-transition);
  }

  .brand-footer__link:hover {
    color: var(--brand-body-muted);
  }

  .brand-footer__utility {
    padding: 24px var(--brand-gutter) 30px;
  }

  .brand-footer__payments {
    max-width: var(--brand-max-width);
    margin: 0 auto 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .brand-footer__payment {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 30px;
    padding-inline: 9px;
    border: 1px solid rgb(var(--brand-navy-rgb) / 0.14);
    border-radius: 3px;
    background: var(--brand-white);
  }

  .brand-footer__payment img {
    display: block;
    height: 22px;
    width: auto;
    object-fit: contain;
  }

  .brand-footer__meta {
    max-width: var(--brand-max-width);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }

  .brand-footer__copyright {
    font: 400 0.6875rem / 1.5 var(--brand-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-label-muted);
  }

  .brand-footer__meta-end {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .brand-footer__locale {
    display: flex;
    align-items: center;
    padding: 8px 14px;
    border: 1px solid rgb(var(--brand-navy-rgb) / 0.16);
    border-radius: var(--brand-radius-pill);
    font: var(--brand-type-label);
    font-size: 0.65625rem;
    letter-spacing: 0.1em;
    color: var(--brand-body-muted);
    white-space: nowrap;
  }

  .brand-footer__social {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .brand-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--brand-social-size);
    height: var(--brand-social-size);
    border-radius: 50%;
    background: var(--brand-navy);
    color: var(--brand-white);
    transition: opacity var(--brand-transition);
  }

  .brand-footer__social-link:hover {
    opacity: 0.7;
  }

  .brand-footer__band {
    background: var(--brand-navy);
    padding: clamp(1.75rem, 3vw, 2.75rem) 0 10px;
    overflow: hidden;
  }

  .brand-footer__band img {
    display: block;
    width: 100%;
    opacity: 0.92;
  }

  @media screen and (max-width: 759px) {
    .brand-footer__social-link {
      width: var(--brand-tap-target);
      height: var(--brand-tap-target);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "brand-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "locale_label",
      "label": "Locale pill",
      "default": "SAUDI ARABIA · SAR · ENGLISH"
    },
    {
      "type": "checkbox",
      "id": "show_payment_marks",
      "label": "Show payment marks",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_footer_on_cart",
      "label": "Show link columns on the cart",
      "default": false,
      "info": "The cart is designed to end on the wordmark band alone."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
